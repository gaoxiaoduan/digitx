{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "digitx-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "digitx-api.33338888.xyz",
			"custom_domain": true
		}
	],
	"secrets": {
		"required": [
			"SYNC_SECRET"
		]
	},
	"kv_namespaces": [
		{
			"binding": "DIGITX_KV",
			"id": "dce4599de8e34bffb2f0c875e7d58c93"
		},
	]
}
